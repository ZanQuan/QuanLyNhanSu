													<Style>Solid</Style>
												</Border>
												<PaddingLeft>2pt</PaddingLeft>
												<PaddingRight>2pt</PaddingRight>
												<PaddingTop>2pt</PaddingTop>
												<PaddingBottom>2pt</PaddingBottom>
												<BackgroundColor>=IIF(Fields!SoNgayTangCa.Value > 0, "#e0ffe0", "White")</BackgroundColor>
											</Style>
										</Textbox>
									</CellContents>
								</TablixCell>
								<TablixCell>
									<CellContents>
										<Textbox Name="D_KetQua">
											<CanGrow>true</CanGrow>
											<Paragraphs>
												<Paragraph>
													<TextRuns>
														<TextRun>
															<Value>=Fields!KetQua.Value</Value>
															<Style>
																<FontFamily>Times New Roman</FontFamily>
																<FontSize>10pt</FontSize>
																<FontWeight>Bold</FontWeight>
															</Style>
														</TextRun>
													</TextRuns>
													<Style>
														<TextAlign>Center</TextAlign>
													</Style>
												</Paragraph>
											</Paragraphs>
											<Style>
												<Border>
													<Style>Solid</Style>
												</Border>
												<PaddingLeft>2pt</PaddingLeft>
												<PaddingRight>2pt</PaddingRight>
												<PaddingTop>2pt</PaddingTop>
												<PaddingBottom>2pt</PaddingBottom>
												<BackgroundColor>=SWITCH(Fields!KetQua.Value="Khen thưởng","#c8f5c8",Fields!KetQua.Value="Kỷ luật","#f5c8c8",True,"#fff9e6")</BackgroundColor>
												<Color>=SWITCH(Fields!KetQua.Value="Khen thưởng","#1a7a1a",Fields!KetQua.Value="Kỷ luật","#b00000",True,"#7a5f00")</Color>
											</Style>
										</Textbox>
									</CellContents>
