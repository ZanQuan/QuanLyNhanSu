											<CanGrow>true</CanGrow>
											<Paragraphs>
												<Paragraph>
													<TextRuns>
														<TextRun>
															<Value>=Fields!SoNgayTangCa.Value</Value>
															<Style>
																<FontFamily>Times New Roman</FontFamily>
																<FontSize>10pt</FontSize>
															</Style>
														</TextRun>
													</TextRuns>
													<Style>
