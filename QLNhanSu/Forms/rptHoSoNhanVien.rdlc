      <!-- TIÊU ĐỀ -->
      <Textbox Name="txtTieuDe">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>CỘNG HÒA XÃ HỘI CHỦ NGHĨA VIỆT NAM</Value>
                <Style><FontSize>11pt</FontSize><FontWeight>Bold</FontWeight></Style>
              </TextRun>
            </TextRuns>
            <Style><TextAlign>Center</TextAlign></Style>
          </Paragraph>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>Độc lập - Tự do - Hạnh phúc</Value>
                <Style><FontSize>10pt</FontSize><FontStyle>Italic</FontStyle><FontWeight>Bold</FontWeight></Style>
              </TextRun>
            </TextRuns>
            <Style><TextAlign>Center</TextAlign></Style>
          </Paragraph>
          <Paragraph>
            <TextRuns><TextRun><Value xml:space="preserve"> </Value></TextRun></TextRuns>
          </Paragraph>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>HỒ SƠ NHÂN VIÊN</Value>
                <Style><FontSize>16pt</FontSize><FontWeight>Bold</FontWeight></Style>
              </TextRun>
            </TextRuns>
            <Style><TextAlign>Center</TextAlign></Style>
          </Paragraph>
        </Paragraphs>
        <Top>0cm</Top>
        <Left>0cm</Left>
        <Height>2.2cm</Height>
        <Width>19cm</Width>
        <Style>
          <Border><Style>None</Style></Border>
        </Style>
      </Textbox>

      <!-- BẢNG THÔNG TIN + ẢNH -->
      <Tablix Name="tblxThongTin">
        <TablixBody>
          <TablixColumns>
            <TablixColumn><Width>4cm</Width></TablixColumn>
            <TablixColumn><Width>7cm</Width></TablixColumn>
            <TablixColumn><Width>4cm</Width></TablixColumn>
            <TablixColumn><Width>4cm</Width></TablixColumn>
          </TablixColumns>
          <TablixRows>

            <!-- Hàng 1: Mã NV + Ảnh (span 4 hàng) -->
            <TablixRow>
              <Height>0.7cm</Height>
              <TablixCells>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="lblMaNV">
                      <CanGrow>true</CanGrow>
                      <Paragraphs><Paragraph><TextRuns><TextRun>
                        <Value>Mã nhân viên:</Value>
                        <Style><FontWeight>Bold</FontWeight></Style>
                      </TextRun></TextRuns></Paragraph></Paragraphs>
                      <Style><Border><Style>Solid</Style><Color>LightGray</Color></Border><BackgroundColor>LightSteelBlue</BackgroundColor><Padding><Left>3pt</Left></Padding></Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="valMaNV">
                      <CanGrow>true</CanGrow>
                      <Paragraphs><Paragraph><TextRuns><TextRun>
                        <Value>=Fields!MaNV.Value</Value>
                      </TextRun></TextRuns></Paragraph></Paragraphs>
                      <Style><Border><Style>Solid</Style><Color>LightGray</Color></Border><Padding><Left>3pt</Left></Padding></Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
                <TablixCell>
                  <CellContents>
                    <Image Name="imgAnh">
                      <Source>Database</Source>
                      <Value>=Fields!AnhBytes.Value</Value>
                      <MIMEType>image/jpeg</MIMEType>
                      <Sizing>FitProportional</Sizing>
                      <Style>
                        <Border><Style>Solid</Style><Color>Gray</Color></Border>
                      </Style>
                    </Image>
                  </CellContents>
                  <RowSpan>6</RowSpan>
                  <ColSpan>2</ColSpan>
                </TablixCell>
              </TablixCells>
            </TablixRow>

            <!-- Hàng 2: Họ và tên -->
